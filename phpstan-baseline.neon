parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>identifiers" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Entity/Publication.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 2
			path: src/Entity/Scholar.php

		-
			message: '#^PHPDoc tag @var with type Base\\Scholar\\Entity\\Cv\\CvEntry is not subtype of native type Base\\Scholar\\Entity\\Cv\\Award\|Base\\Scholar\\Entity\\Cv\\Degree\|Base\\Scholar\\Entity\\Cv\\Position\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/Service/Synchronizer.php

		-
			message: '#^Using nullsafe property access "\?\-\>affiliations" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Service/Synchronizer.php
